# read-pal Environment Variables
# Copy to packages/server/.env for backend configuration.
# Copy this file to .env and fill in your values.

# ── Database ──────────────────────────────────────────────
# REQUIRED for docker compose deploy — compose fails fast if unset.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=readpal
DB_USER=readpal
DB_PASSWORD=changeme

# Connection pool (per worker). Defaults: 20 + 10 overflow, 30min recycle.
# Total connections ≈ workers × (DB_POOL_SIZE + DB_MAX_OVERFLOW) — keep under
# Postgres max_connections minus headroom (default 100).
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO (Object Storage) ───────────────────────────────
# ⚠ SECURITY: minioadmin/minioadmin are factory defaults. Change them on any
# exposed deployment — set real credentials here and on the MinIO server itself.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=readpal

# ── GLM AI (Zhipu) ───────────────────────────────────────
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEFAULT_MODEL=glm-4.7-flash
FALLBACK_MODEL=glm-4-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=3
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_SECONDS=30
MAX_EMBEDDING_CALLS=300
EMBEDDING_ENABLED=true

# ── LLM Budgets (per-user daily cost caps) ───────────────
# Max LLM REQUESTS per user per day (0 = unlimited). Resets at UTC midnight.
LLM_DAILY_BUDGET=200
# Max LLM TOKENS per user per day (0 = disabled). Counts tokens, not requests,
# so long-context abusers can't game the request cap.
LLM_DAILY_TOKEN_BUDGET=500000

# ── Multi-Provider LLM Routing (hot-pluggable) ──────────
# JSON array of provider configs. When empty, falls back to GLM_* single-provider mode.
# Each provider: name, base_url, api_key, models, priority (lower=preferred),
#   cost_weight (used for "cheapest" routing), max_rpm/max_tpm (0=unlimited)
#
# HOT-PLUG: providers are re-read on every LLM call (fingerprint compare —
# zero cost when unchanged) and can be swapped at runtime without restart:
#   GET  /api/v1/llm-providers         — list providers + circuit/RPM state
#   POST /api/v1/llm-providers/reload  — re-read env, rebuild if changed
#   PUT  /api/v1/llm-providers         — push a full provider list (in-memory
#                                        until restart; keep LLM_PROVIDERS
#                                        as the durable source of truth)
# Existing providers keep circuit-breaker/latency state across reloads;
# invalid config edits never empty the registry (previous set keeps serving).
#
# Example: GLM primary + Xiaomi MiMo failover (both OpenAI-compatible):
#   MiMo platform: https://platform.xiaomimimo.com/ — base URL
#   https://api.xiaomimimo.com/v1, models: mimo-v2.5 / mimo-v2.5-pro
#   (mimo-v2.5 is a reasoning model — higher latency, returns
#   reasoning_content; the final answer lands in content as usual.)
#
# LLM_PROVIDERS=[{"name":"glm","base_url":"https://open.bigmodel.cn/api/paas/v4","api_key":"YOUR_GLM_KEY","models":{"default":"glm-4.7-flash","fallback":"glm-4-flash"},"priority":1,"cost_weight":0.3,"max_rpm":60},{"name":"mimo","base_url":"https://api.xiaomimimo.com/v1","api_key":"YOUR_MIMO_KEY","models":{"default":"mimo-v2.5"},"priority":2,"cost_weight":0.8,"max_rpm":30}]
#
# Feature-to-routing-strategy mapping (optional)
# Strategies: "cheapest", "best", "fastest", or a specific provider name
#
# LLM_FEATURE_ROUTING={"mood-scene":"cheapest","companion_stream":"fastest","Synthesis":"best"}

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=generate-a-random-32-char-secret
JWT_EXPIRES_IN=7d
JWT_ACCESS_WEB=30m
JWT_ACCESS_MOBILE=2h
JWT_REFRESH_WEB=7d
JWT_REFRESH_MOBILE=30d

# ── App ───────────────────────────────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
LLM_LOG_ENABLED=false
LLM_LOG_RETENTION_DAYS=90

# ── Cache TTL ─────────────────────────────────────────────
# Duration format: <number><d|h|m|s>  e.g. 7d, 1h, 30m, 60s
CACHE_LLM_TTL=30m
CACHE_RAG_TTL=30m
CACHE_KNOWLEDGE_TTL=7d
CACHE_LLM_MAX_ENTRIES=500

# ── SMTP (optional — console fallback when unset) ─────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
