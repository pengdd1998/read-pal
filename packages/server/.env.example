# read-pal Server Environment Variables
# Copy this file to .env and fill in your values.

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=readpal
DB_USER=readpal
DB_PASSWORD=changeme
# SQL echo logging (default false — echo-on buried real signal under 73k lines/hr)
# DB_ECHO=false
# Connection pool (per worker; total ≈ workers × (pool + overflow) — stay under
# Postgres max_connections). Read by app/db.py directly, bypassing Settings.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── GLM AI (Zhipu) ───────────────────────────────────────
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEFAULT_MODEL=glm-4.7-flash
FALLBACK_MODEL=glm-4-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=3
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_SECONDS=30
MAX_EMBEDDING_CALLS=300
EMBEDDING_ENABLED=true
# Embedding provider override (any OpenAI-compatible /embeddings; empty falls
# back to GLM values). Local Ollama example:
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY=

# Per-user daily caps (Redis counters, reset UTC midnight; 0 = unlimited).
# LLM_DAILY_BUDGET counts REQUESTS, LLM_DAILY_TOKEN_BUDGET counts TOKENS.
# LLM_DAILY_BUDGET=0
# LLM_DAILY_TOKEN_BUDGET=0
# Filter at-cap providers out of routing decisions (observe a week of real TPM
# numbers before enabling). TPM windows are tracked either way.
# TPM_ENFORCED=false
# Global cap on concurrent LLM streams across all workers (Redis INCR/DECR).
# LLM_MAX_CONCURRENT_STREAMS=20
# Pass response_format=json_object to providers when a schema is requested.
# Verify provider support before enabling (DeepSeek's is partial).
# LLM_NATIVE_STRUCTURED_OUTPUT=false
# Reasoning-model max_tokens multiplier (read by services/llm/pool.py).
# LLM_REASONING_TOKEN_SCALE=5

# ── Live prompt eval (optional; see app/eval/live_runner.py) ──
# PROMPT_EVAL_API_KEY=            # defaults to GLM_API_KEY when unset
# MAX_LIVE_EVAL_TOKENS=50000

# ── Multi-Provider LLM Routing (optional) ───────────────
# JSON array of provider configs. When empty, falls back to GLM_* single-provider mode.
# Each provider: name, base_url, api_key, models, priority (lower=preferred),
#   cost_weight (used for "cheapest" routing), max_rpm (0=unlimited)
#
# Recommended cost-effective setup:
#   Tier 1 (free, primary):  GLM-4.7-Flash  — all routine tasks
#   Tier 2 (cheap, fallback): DeepSeek-Chat  — overflow when GLM rate-limited
#   Tier 3 (paid, quality):   GPT-4.1-nano   — complex reasoning tasks only
#
# LLM_PROVIDERS=[{"name":"glm","base_url":"https://open.bigmodel.cn/api/paas/v4","api_key":"YOUR_GLM_KEY","models":{"default":"glm-4.7-flash","fallback":"glm-4-flash"},"priority":1,"cost_weight":0.0,"max_rpm":60},{"name":"deepseek","base_url":"https://api.deepseek.com/v1","api_key":"YOUR_DEEPSEEK_KEY","models":{"default":"deepseek-chat"},"priority":2,"cost_weight":0.07,"max_rpm":60},{"name":"openai","base_url":"https://api.openai.com/v1","api_key":"YOUR_OPENAI_KEY","models":{"default":"gpt-4.1-nano"},"priority":3,"cost_weight":0.1,"max_rpm":30}]
#
# Feature-to-routing-strategy mapping (optional)
# Strategies: "cheapest", "best", "fastest", or a specific provider name
#
# LLM_FEATURE_ROUTING={"mood-scene":"cheapest","Conversation summary":"cheapest","Knowledge concept extraction":"cheapest","companion_stream":"fastest","Synthesis":"best","Cross-book synthesis":"best","Book comparison":"best","Companion explain":"best"}

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=generate-a-random-32-char-secret
JWT_EXPIRES_IN=7d
JWT_ACCESS_WEB=30m
JWT_ACCESS_MOBILE=2h
JWT_REFRESH_WEB=7d
JWT_REFRESH_MOBILE=30d

# ── App ───────────────────────────────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# TZ=Asia/Shanghai   # read by app/__init__.py (defaults to local)

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
# Persist llm_call_traces to the DB (default true since 2026-09-05 — set
# false only for load tests / local runs where you don't want trace rows).
LLM_LOG_ENABLED=true
# Rows older than this are pruned by the trace writer (check every 6h).
# 0 or negative = keep forever.
LLM_LOG_RETENTION_DAYS=90
# Append-only JSONL mirror of every llm_call / llm_cache_hit record (empty =
# off). Local replay/audit channel that needs no external platform — point it
# at a path on a persistent volume if you want badcase replay material.
# LLM_TRACE_JSONL_PATH=/var/log/read-pal/llm_traces.jsonl
# Opt-in prompt/output preview capture for badcase triage. Previews go ONLY
# to the JSONL file (never the DB), truncated to LLM_TRACE_CAPTURE_CHARS.
# May contain user text — enable temporarily while triaging, then turn off.
# LLM_TRACE_CAPTURE_CONTENT=false
# LLM_TRACE_CAPTURE_CHARS=800

# ── Cache TTL ─────────────────────────────────────────────
# Duration format: <number><d|h|m|s>  e.g. 7d, 1h, 30m, 60s
CACHE_LLM_TTL=30m
CACHE_RAG_TTL=30m
CACHE_KNOWLEDGE_TTL=7d
CACHE_LLM_MAX_ENTRIES=500
# CACHE_DATA_TTL=5m
# CACHE_RECOMMENDATION_TTL=10m

# ── Idempotency ───────────────────────────────────────────
# When True, POST/PUT/PATCH routes protected by `idempotent` /
# `idempotent_stream` require an Idempotency-Key header (UUID or 32-char
# hex). Both web and mobile API clients auto-attach a deterministic key
# on mutations and a random UUID per streaming click — leave True in prod
# to close the double-click → duplicate LLM billing vector (review B1).
# Set False in dev/test to exercise legacy clients without the header.
IDEMPOTENCY_ENFORCE=true

# ── SMTP (optional — console fallback when unset) ─────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# ── Object storage (optional — MinIO / S3-compatible) ─────
# When configured, uploaded book covers are stored here and book.cover_url
# holds the public object URL. When unset, covers fall back to the gradient
# placeholder. OSS_PUBLIC_BASE_URL is the public URL prefix for the bucket
# (what the browser reaches); OSS_ENDPOINT is the S3 API host:port.
# OSS_ENDPOINT=minio.example.com:9000
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_BUCKET=read-pal
# OSS_PUBLIC_BASE_URL=https://cdn.example.com/read-pal
# OSS_SECURE=true
