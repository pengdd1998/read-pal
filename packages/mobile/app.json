{
  "expo": {
    "name": "ReadPal",
    "slug": "read-pal",
    "version": "1.1.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "readpal",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.readpal.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f9f5f0"
      },
      "package": "com.readpal.app",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "./plugins/withCleartextTraffic"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c7e9560e-effd-4979-8d21-e1430d6a55e9"
      }
    },
    "owner": "codelabor"
  }
}
